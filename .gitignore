# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output — Vercel's own buildCommand (see vercel.json) rebuilds
# api-server and quote-ai from source on every deploy, so nothing under
# dist/ needs to be committed.
dist
tmp
api/data/
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

.vercel

# Local Claude Code dev-server launch config — personal, not project source
.claude/

# Google service account keys — never commit
*service-account*.json
gen-lang-client-*.json
**/google-indexing-key.json

# Secrets / environment files — never commit
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

.vercel
.env*

# Supabase CLI link state
supabase/.temp/
.walkthrough-mailbox.json
