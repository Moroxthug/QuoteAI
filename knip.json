{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "lib/integrations/**",
    "lib/integrations-openai-ai-react/src/audio/audio-playback-worklet.js",
    "artifacts/quote-ai/public/sw.js",
    "artifacts/quote-ai/public/widget-test.js"
  ],
  "ignoreIssues": {
    "artifacts/quote-ai/src/components/ui/**": [
      "exports",
      "types"
    ],
    "artifacts/quote-ai/src/lib/*-api.ts": [
      "types"
    ]
  },
  "ignoreDependencies": [
    "prettier",
    "pdfkit",
    "pdf-parse",
    "mammoth",
    "xlsx",
    "@google/genai",
    "@types/react-dom",
    "@types/pdf-parse"
  ],
  "ignoreBinaries": [
    "ffmpeg",
    "stripe"
  ],
  "rules": {
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "duplicates": "warn",
    "catalog": "warn"
  },
  "workspaces": {
    ".": {
      "entry": [
        "api/index.js"
      ]
    },
    "artifacts/api-server": {
      "entry": [
        "src/index.ts",
        "src/app.ts",
        "src/**/*.test.ts",
        "src/e2e/**",
        "scripts/*.ts"
      ]
    },
    "artifacts/quote-ai": {
      "entry": [
        "index.html",
        "scripts/*.ts",
        "server/*.mjs",
        "src/entry-server.tsx",
        "src/widget/widget.ts"
      ]
    },
    "lib/db": {
      "drizzle": false,
      "entry": [
        "drizzle.config.ts",
        "scripts/*.ts"
      ]
    },
    "scripts": {
      "entry": [
        "src/*.ts"
      ]
    },
    "artifacts/mobile": {
      "entry": [
        "scripts/*.ts"
      ],
      "ignoreDependencies": [
        "@capacitor/app",
        "@capacitor/keyboard",
        "@capacitor/splash-screen",
        "@capacitor/status-bar",
        "@aparajita/capacitor-secure-storage",
        "@capacitor/browser",
        "@capacitor-mlkit/document-scanner",
        "@capgo/capacitor-native-biometric",
        "@capacitor/app-launcher",
        "@capacitor/camera",
        "@capacitor/haptics",
        "@capacitor/filesystem",
        "@capacitor/geolocation",
        "@capacitor/push-notifications",
        "@capacitor/share",
        "@capawesome/capacitor-app-shortcuts",
        "@capgo/capacitor-share-target"
      ]
    }
  }
}
