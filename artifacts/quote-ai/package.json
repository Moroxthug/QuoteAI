{
  "name": "@workspace/quote-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "generate-og": "tsx ./scripts/generate-blog-og-images.ts && tsx ./scripts/generate-sector-og-images.ts",
    "prebuild": "tsx ./scripts/generate-sitemap.ts && tsx ./scripts/generate-blog-og-images.ts && tsx ./scripts/generate-sector-og-images.ts",
    "prerender": "vite build --config vite.config.ts --ssr src/entry-server.tsx --outDir dist/server && tsx ./scripts/generate-blog-og-images.ts && tsx ./scripts/generate-sector-og-images.ts && tsx ./scripts/prerender-seo.ts",
    "build": "vite build --config vite.config.ts && vite build --config vite.config.ts --ssr src/entry-server.tsx --outDir dist/server && tsx ./scripts/generate-blog-og-images.ts && tsx ./scripts/generate-sector-og-images.ts && tsx ./scripts/prerender-seo.ts && tsx ./scripts/build-sw.ts && node ../../scripts/sentry-sourcemaps.mjs --delete-maps dist/public/assets",
    "serve": "node server/serve.mjs",
    "serve:vite": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate-prerender": "tsx ./scripts/validate-prerender.ts",
    "validate-sitemap": "tsx ./scripts/validate-sitemap.ts",
    "submit-to-google": "tsx ./scripts/submit-to-google.ts",
    "ga-traffic-report": "tsx ./scripts/ga-traffic-report.ts",
    "gsc-inspect": "tsx ./scripts/gsc-inspect-urls.ts",
    "i18n-audit": "tsx ./scripts/i18n-audit.ts",
    "qa:lighthouse": "tsx ./scripts/lighthouse.ts"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.7",
