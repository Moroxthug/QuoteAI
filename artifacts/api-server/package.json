{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs && node ../../scripts/sentry-sourcemaps.mjs --ext mjs --ext map dist/app.mjs dist/app.mjs.map dist/index.mjs dist/index.mjs.map",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "route-matrix": "node scripts/route-matrix.ts --write",
    "email-dns-check": "node scripts/email-dns-check.ts",
    "csp-hashes": "tsx scripts/csp-hashes.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "walkthrough": "tsx src/e2e/walkthrough.ts",
    "walkthrough:cleanup": "tsx src/e2e/walkthrough-cleanup.ts",
    "qa:visual": "tsx src/e2e/visual-a11y.ts",
    "qa:pdf": "tsx src/e2e/pdf-matrix.ts",
    "qa:perf": "tsx src/e2e/api-perf.ts",
    "ops:backup": "tsx scripts/backup.ts",
    "ops:restore": "tsx scripts/restore.ts",
    "ops:rotate-token-key": "tsx scripts/rotate-token-key.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@types/pdfmake": "^0.3.2",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/error-reporting": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "better-auth": "^1.6.9",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^7",
    "kysely": "^0.28.17",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pdfmake": "^0.3.7",
    "pino": "^9",
    "pino-http": "^10",
    "posthog-node": "^5.40.0",
    "resend": "^6.12.2",
    "stripe": "^22.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "axe-core": "^4.13.0",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "pino-pretty": "^13",
    "playwright-core": "^1.63.0",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "typescript": "~5.9.2",
    "vitest": "^5.0.0"
  }
}
