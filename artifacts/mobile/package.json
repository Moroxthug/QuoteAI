{
  "name": "@workspace/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "tsx ./scripts/build-web.ts",
    "icons": "tsx ./scripts/icons.ts",
    "sync": "pnpm run build:web && cap sync android",
    "android:debug": "pnpm run sync && tsx ./scripts/gradle.ts assembleDebug",
    "android:release": "pnpm run sync && tsx ./scripts/gradle.ts bundleRelease",
    "open:android": "cap open android",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "catalog:",
    "tsx": "catalog:"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-mlkit/document-scanner": "^8.2.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capawesome/capacitor-app-shortcuts": "^8.0.2",
    "@capgo/capacitor-share-target": "^8.0.54"
  }
}
