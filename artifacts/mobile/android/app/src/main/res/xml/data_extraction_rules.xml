<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 118: nothing leaves the phone in a cloud backup or a device transfer —
     the app keeps a copy of the company's quotes, clients and jobs (Phase 116)
     and its sign-in lives in the keystore. Signing in again restores everything. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
