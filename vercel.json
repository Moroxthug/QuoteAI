{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/api-server build && pnpm --filter @workspace/quote-ai build",
  "outputDirectory": "artifacts/quote-ai/dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "artifacts/api-server/dist/{node_modules,data}/**"
    }
  },
  "redirects": [
    { "source": "/((?!api/).*)", "has": [{ "type": "host", "value": "quote-ai-chi.vercel.app" }], "destination": "https://quoteai.ca/$1", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/chi-siamo{/}?", "destination": "/about/", "permanent": true },
    { "source": "/contatti{/}?", "destination": "/contact/", "permanent": true },
    { "source": "/mappa-sito{/}?", "destination": "/site-map/", "permanent": true },
    { "source": "/seo{/}?", "destination": "/", "permanent": true },
    { "source": "/blog/categoria/(.*)", "destination": "/blog/category/$1", "permanent": true },
    { "source": "/blog/category/(trades|pricing){/}?", "destination": "/blog/", "permanent": true },
    { "source": "/blog/how-to-get-more-electrical-jobs-canada{/}?", "destination": "/blog/how-to-get-more-jobs-as-a-contractor-canada/", "permanent": true },
    { "source": "/blog/how-to-get-more-plumbing-jobs-canada{/}?", "destination": "/blog/how-to-get-more-jobs-as-a-contractor-canada/", "permanent": true },
    { "source": "/blog/cost-to-rewire-a-house-canada{/}?", "destination": "/blog/how-to-quote-an-electrical-job/", "permanent": true },
    { "source": "/blog/cost-to-reroof-a-home-canada{/}?", "destination": "/blog/how-to-quote-a-roofing-job/", "permanent": true },
    { "source": "/blog/snow-load-roofing-eavestrough-considerations-canada{/}?", "destination": "/blog/how-to-quote-a-roofing-job/", "permanent": true },
    { "source": "/blog/cost-to-install-a-heat-pump-canada{/}?", "destination": "/blog/how-to-quote-an-hvac-job/", "permanent": true },
    { "source": "/blog/furnace-replacement-cost-canada-2026{/}?", "destination": "/blog/how-to-quote-an-hvac-job/", "permanent": true },
    { "source": "/blog/cost-to-install-windows-and-doors-canada{/}?", "destination": "/blog/how-to-quote-a-window-or-door-installation-job/", "permanent": true },
    { "source": "/blog/concrete-driveway-cost-canada-2026{/}?", "destination": "/blog/how-to-quote-a-masonry-job/", "permanent": true },
    { "source": "/blog/attic-insulation-cost-canada-2026{/}?", "destination": "/blog/canada-greener-homes-grant-rebates-contractors-guide-2026/", "permanent": true },
    { "source": "/blog/common-quoting-mistakes-contractors-make{/}?", "destination": "/blog/how-to-write-a-professional-quote-that-wins-jobs/", "permanent": true },
    { "source": "/blog/how-to-win-more-bids-contractors-canada{/}?", "destination": "/blog/how-to-write-a-professional-quote-that-wins-jobs/", "permanent": true },
    { "source": "/blog/how-to-send-a-quote-in-5-minutes-contractors{/}?", "destination": "/blog/how-to-write-a-professional-quote-that-wins-jobs/", "permanent": true },
    { "source": "/blog/mobile-quoting-on-the-go-for-contractors{/}?", "destination": "/blog/how-to-write-a-professional-quote-that-wins-jobs/", "permanent": true },
    { "source": "/blog/how-to-price-a-job-labour-materials-markup-canada-guide{/}?", "destination": "/tools/markup-margin-calculator/", "permanent": true },
    { "source": "/blog/best-quoting-software-for-contractors-canada{/}?", "destination": "/compare/", "permanent": true },
    { "source": "/blog/quoteai-vs-spreadsheet-quotes-contractors{/}?", "destination": "/compare/", "permanent": true },
    { "source": "/blog/how-to-survive-slow-season-contractors-canada{/}?", "destination": "/blog/how-to-scale-a-contracting-business-canada/", "permanent": true },
    { "source": "/seo/(.*)", "destination": "/", "permanent": true },
    { "source": "/privacy{/}?", "destination": "/privacy-policy/", "permanent": true },
    { "source": "/termini{/}?", "destination": "/terms/", "permanent": true },
    { "source": "/quotes/excel-template{/}?", "destination": "/tools/", "permanent": true },
    { "source": "/quotes/excel-template/(.+)", "destination": "/tools/", "permanent": true },
    { "source": "/quotes/word-template{/}?", "destination": "/tools/", "permanent": true },
    { "source": "/quotes/word-template/(.+)", "destination": "/tools/", "permanent": true },
    { "source": "/quotes/free-quote{/}?", "destination": "/pricing/", "permanent": true },
    { "source": "/quotes/free-quote/(.+)", "destination": "/pricing/", "permanent": true },
    { "source": "/quotes/how-to-quote{/}?", "destination": "/blog/how-to-write-a-professional-quote-that-wins-jobs/", "permanent": true },
    { "source": "/quotes/how-to-quote/(.+)", "destination": "/blog/how-to-write-a-professional-quote-that-wins-jobs/", "permanent": true },
    { "source": "/quotes/decorative-painter{/}?", "destination": "/quotes/painter/", "permanent": true },
    { "source": "/quotes/decorative-painter/(.+)", "destination": "/quotes/painter/", "permanent": true },
    { "source": "/quotes/building-consultant{/}?", "destination": "/quotes/general-contractor/", "permanent": true },
    { "source": "/quotes/building-consultant/(.+)", "destination": "/quotes/general-contractor/", "permanent": true },
    { "source": "/fr/soumissions/modele-soumission-excel{/}?", "destination": "/fr/outils/", "permanent": true },
    { "source": "/fr/soumissions/modele-soumission-excel/(.+)", "destination": "/fr/outils/", "permanent": true },
    { "source": "/fr/soumissions/soumission-gratuite{/}?", "destination": "/fr/tarifs/", "permanent": true },
    { "source": "/fr/soumissions/soumission-gratuite/(.+)", "destination": "/fr/tarifs/", "permanent": true },
    { "source": "/fr/soumissions/comment-faire-une-soumission{/}?", "destination": "/fr/guides/", "permanent": true },
    { "source": "/fr/soumissions/comment-faire-une-soumission/(.+)", "destination": "/fr/guides/", "permanent": true },
    { "source": "/fr/soumissions/peintre-decorateur{/}?", "destination": "/fr/soumissions/peintre/", "permanent": true },
    { "source": "/fr/soumissions/peintre-decorateur/(.+)", "destination": "/fr/soumissions/peintre/", "permanent": true },
    { "source": "/fr/soumissions/expert-batiment{/}?", "destination": "/fr/soumissions/entrepreneur-general/", "permanent": true },
    { "source": "/fr/soumissions/expert-batiment/(.+)", "destination": "/fr/soumissions/entrepreneur-general/", "permanent": true },
    { "source": "/quotes/([^/]+)/(mississauga|hamilton|surrey|victoria|winnipeg|quebec-city|gatineau|laval|halifax)/(.*)", "destination": "/quotes/$1/", "permanent": true },
    { "source": "/fr/soumissions/([^/]+)/(quebec-city|gatineau|laval)/(.*)", "destination": "/fr/soumissions/$1/", "permanent": true },
    {
      "source": "/((?!api/)(?!.*\\.)[^/]+(?:/[^/]+)*)",
      "destination": "/$1/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/dashboard",
      "destination": "/app.html"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/app.html"
    },
    { "source": "/sign-in", "destination": "/spa.html" },
    { "source": "/sign-in/(.*)", "destination": "/spa.html" },
    { "source": "/sign-up", "destination": "/spa.html" },
    { "source": "/sign-up/(.*)", "destination": "/spa.html" },
    { "source": "/onboarding", "destination": "/spa.html" },
    { "source": "/onboarding/(.*)", "destination": "/spa.html" },
    { "source": "/welcome", "destination": "/spa.html" },
    { "source": "/welcome/(.*)", "destination": "/spa.html" },
    { "source": "/admin", "destination": "/spa.html" },
    { "source": "/admin/(.*)", "destination": "/spa.html" },
    { "source": "/crm", "destination": "/spa.html" },
    { "source": "/crm/(.*)", "destination": "/spa.html" },
    { "source": "/sign", "destination": "/spa.html" },
    { "source": "/sign/(.*)", "destination": "/spa.html" },
    { "source": "/portal", "destination": "/spa.html" },
    { "source": "/portal/(.*)", "destination": "/spa.html" },
    { "source": "/i", "destination": "/spa.html" },
    { "source": "/i/(.*)", "destination": "/spa.html" },
    { "source": "/t", "destination": "/spa.html" },
    { "source": "/t/(.*)", "destination": "/spa.html" },
    { "source": "/team-invite", "destination": "/spa.html" },
    { "source": "/team-invite/(.*)", "destination": "/spa.html" },
    { "source": "/join", "destination": "/spa.html" },
    { "source": "/join/(.*)", "destination": "/spa.html" },
    { "source": "/p", "destination": "/spa.html" },
    { "source": "/p/(.*)", "destination": "/spa.html" }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-mFB9+Lexq04yPatMHWh64iW3VSpRNJwxUdZpmtRsgO8=' 'sha256-9MMG6OrvnwWTdQLO1CZKS06E2ogYuM5lGTR5lMbPY9M=' 'sha256-RSOetybfuAeYjq18wS+ZfwiZK9xhzP8+T4TTsgklDIk=' https://www.googletagmanager.com https://*.posthog.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https://*.sentry.io https://*.posthog.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src https://*.private.fin.ag; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self), payment=()"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/widget.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    },
    {
      "source": "/widget-test.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "VERCEL_SKIP_TYPECHECK": "1"
  },
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/evening",
      "schedule": "0 23 * * *"
    }
  ]
}
