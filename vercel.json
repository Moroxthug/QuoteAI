{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/api-server build && pnpm --filter @workspace/quote-ai build",
  "outputDirectory": "artifacts/quote-ai/dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "artifacts/api-server/dist/{node_modules,data}/**"
    }
  },
  "redirects": [
    {
      "source": "/((?!api/)(?!.*\\.)[^/]+(?:/[^/]+)*)",
      "destination": "/$1/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-mFB9+Lexq04yPatMHWh64iW3VSpRNJwxUdZpmtRsgO8=' 'sha256-80Cw9eXu1Y58KDiQ50ks27jMNQxXoYkEzYpNkreeLkY=' 'sha256-RSOetybfuAeYjq18wS+ZfwiZK9xhzP8+T4TTsgklDIk=' https://www.googletagmanager.com https://*.posthog.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https://*.sentry.io https://*.posthog.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src https://*.private.fin.ag; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self), payment=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "VERCEL_SKIP_TYPECHECK": "1"
  },
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/evening",
      "schedule": "0 23 * * *"
    }
  ]
}
