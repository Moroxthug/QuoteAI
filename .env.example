# Copy to .env and fill in real values. Never commit the real .env file.

# Better Auth secret for local sessions (generate: openssl rand -hex 32)
BETTER_AUTH_SECRET=

# Supabase Postgres connection string
DATABASE_URL=

# Groq API key for LLM-powered quote generation (or set AI_MODEL to use Gemini instead)
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# Environment
NODE_ENV=development
QUOTEAI_BASE_URL=http://localhost:5173

# Resend API key for transactional email (signup, password reset, quote PDFs)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Stripe (use CAD-denominated test price IDs — sk_test_.../pk_test_...)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase Storage (public/private asset buckets)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=public-assets
SUPABASE_PRIVATE_BUCKET=private-assets

# Admin dashboard access
ADMIN_EMAIL=

# Telemetry / Analytics (PostHog free tier)
POSTHOG_KEY=
POSTHOG_HOST=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Shared secret for the scheduled automation tick (/api/cron/tick).
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>"
# when the env var is set in the project (generate: openssl rand -hex 32).
CRON_SECRET=

# QuickBooks Online OAuth app (developer.intuit.com) — Phase 11 sync.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:5000/api/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox

# Google Calendar OAuth app (console.cloud.google.com) — Phase 12 sync.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/calendar/google/callback

# Wave accounting OAuth app (developer.waveapps.com) — Phase 25 sync.
WAVE_CLIENT_ID=
WAVE_CLIENT_SECRET=
WAVE_REDIRECT_URI=http://localhost:5000/api/wave/callback

# Meta (Facebook/Instagram) Lead Ads (developers.facebook.com) — Phase 28 lead capture.
# Reuses the same Meta developer app as the Phase 9 WhatsApp Cloud API integration if
# desired, but needs its own leadgen webhook subscription + verify token.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/meta-lead-ads/callback
META_LEADGEN_VERIFY_TOKEN=

# Gmail OAuth app (console.cloud.google.com) — Phase 20 connected email sending.
# Send-only (gmail.send), a Google "sensitive" scope — standard OAuth verification,
# no CASA security assessment required.
GMAIL_SEND_CLIENT_ID=
GMAIL_SEND_CLIENT_SECRET=
GMAIL_SEND_REDIRECT_URI=http://localhost:5000/api/email-connections/google/callback

# AES-256-GCM key for encrypting third-party OAuth tokens at rest (QuickBooks/Calendar/Gmail
# refresh/access tokens). Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
