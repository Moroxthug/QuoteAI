# Copy to .env and fill in real values. Never commit the real .env file.

# Better Auth secret for local sessions (generate: openssl rand -hex 32)
BETTER_AUTH_SECRET=

# Supabase Postgres connection string
DATABASE_URL=

# Groq API key for LLM-powered quote generation (or set AI_MODEL to use Gemini instead)
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# Environment
NODE_ENV=development
QUOTEAI_BASE_URL=http://localhost:5173

# Resend API key for transactional email (signup, password reset, quote PDFs)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Stripe (use CAD-denominated test price IDs — sk_test_.../pk_test_...)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase Storage (public/private asset buckets)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=public-assets
SUPABASE_PRIVATE_BUCKET=private-assets

# Admin dashboard access
ADMIN_EMAIL=

# Telemetry / Analytics (PostHog free tier)
POSTHOG_KEY=
POSTHOG_HOST=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Shared secret for the scheduled automation tick (/api/cron/tick).
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>"
# when the env var is set in the project (generate: openssl rand -hex 32).
CRON_SECRET=

# QuickBooks Online OAuth app (developer.intuit.com) — Phase 11 sync.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:5000/api/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox

# AES-256-GCM key for encrypting third-party OAuth tokens at rest (QuickBooks refresh/access
# tokens). Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
